# Copy this file:  cp .env.example .env
# Then customize values as needed.
OLLAMA_MODEL=qwen2.5:3b
# context window sent with every LLM call; must fit config + reply (edit prompts are ~800 tokens)
LLM_NUM_CTX=16384
SCHEMA_PORT=7001
VALUES_PORT=7002
# uid/gid values-server writes data/values as (Linux: match the checkout owner, `id -u` / `id -g`)
APP_UID=1000
APP_GID=1000
BOT_PORT=7000
OLLAMA_PORT=11434
SCHEMA_URL=http://schema-server:7001
VALUES_URL=http://values-server:7002
OLLAMA_URL=http://ollama:11434
OLLAMA_MEMORY_LIMIT=16G
OLLAMA_MEMORY_RESERVATION=8G
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_ADMIN_PASSWORD=admin
